// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  email         String   @unique
  password      String?
  job_statuses  Json     @default("[{\"label\":\"bookmarked\",\"value\":0},{\"label\":\"applied\",\"value\":0},{\"label\":\"accepted\",\"value\":0},{\"label\":\"rejected\",\"value\":0}]")
  bookmarked_jobs String[]
  jobs          Tracked_Jobs[]
  created_at    DateTime @default(now())
  
  // Resume information
  resume        Json?    // Stores the entire parsed resume
}

// Jobs tracked by users
model Tracked_Jobs {
  id            String  @id @default(uuid()) @db.Uuid
  title         String
  job_link      String?
  job_type      String?
  job_id        String? @unique
  apply_link    String?
  job_location  String?
  salary_min    String?   
  salary_max    String?
  job_salary    String?  
  experience_min Int?     
  experience_max Int?   
  experience    String? 
  job_description String? 
  skills_required String? 
  source        String?
  source_logo   String?
  posted        DateTime? @default(now())
  status        String  @default("applied")

  userId        String  @db.Uuid
  user          User    @relation(fields: [userId], references: [id])

  companyId     String?   @db.Uuid
  company       Company?  @relation(fields: [companyId], references: [id])
  @@unique([title, companyId, userId], map: "UniqueTrackedJob")
}

model Company {
  id               String   @id @default(uuid()) @db.Uuid
  company_name     String   @unique(map: "UniqueCompanyName")
  description      String?
  about            Json?
  company_link     String?
  company_logo     String?
  socials          Json?    // JSON field to store all social media links
  last_job_ids     Json?    // Added this for storing job Ids

  jobs             Job[]
  trackedJobs      Tracked_Jobs[]

  @@unique([company_name], map: "UniqueCompanyNameConstraint") // Ensures that company names are unique
}

model Job {
  id            String   @id @default(uuid()) @db.Uuid
  title         String
  job_link      String
  job_type      String?
  job_id        String? @unique
  apply_link    String?
  job_location  String?
  salary_min    String?   
  salary_max    String?
  job_salary    String?  
  experience_min Int?     
  experience_max Int?   
  experience    String? 
  job_description String? 
  skills_required String? 
  source        String
  source_logo   String?
  posted        DateTime @default(now())
  created_at    DateTime @default(now())
  end_date      DateTime?
  companyId     String   @db.Uuid
  company       Company?  @relation(fields: [companyId], references: [id])

  @@unique([title, companyId], map: "UniqueJobTitleCompany")  // This creates a unique index on title and companyId
}
